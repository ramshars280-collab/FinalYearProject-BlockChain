# ==============================================================================
# TrueCred – Production Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit filled production secrets, private keys, or passwords
# to version control! This template documents all mandatory and optional variables
# required for secure, high-availability production deployment on Ethereum Sepolia.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Canonical public URL of the application.
# CRITICAL: This URL is embedded in official certificate QR codes for 1-click verification.
# Never use localhost or dynamic request headers in production to prevent Host-header poisoning.
NEXT_PUBLIC_APP_URL=https://veritrust.mgmu.ac.in
APP_URL=https://veritrust.mgmu.ac.in

# Whitelist of allowed origins for CSRF validation and CORS.
# Separate multiple origins with commas (e.g. https://veritrust.mgmu.ac.in,https://admin.mgmu.ac.in)
ALLOWED_ORIGINS=https://veritrust.mgmu.ac.in

# Set to 'true' ONLY when running behind a trusted reverse proxy (e.g., Cloudflare, Nginx, AWS ALB)
# that sanitizes and replaces the X-Forwarded-For header with the actual client IP address.
# When 'false', client-supplied forwarding headers are ignored to prevent rate-limit spoofing.
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# High-entropy secret used for signing and verifying HMAC-SHA256 session tokens.
# REQUIRED: Must be at least 32 characters long. In production (NODE_ENV=production),
# the application refuses to start or authenticate if this is missing or using default values.
# Generate via: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# Master password for institutional Examination Authority admin logins (EXAM_ADMIN).
# REQUIRED: Must be a strong unique passphrase. Default "admin123" is blocked in production.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_INSTITUTIONAL_ADMIN_PASSPHRASE

# Default template password for new student accounts before self-service reset.
# Stored as individual scrypt salted hashes (scrypt:<salt_hex>:<hash_hex>) in student_accounts table.
STUDENT_DEFAULT_PASSWORD=REPLACE_WITH_STRONG_DEFAULT_STUDENT_PASSPHRASE

# Administrative Identity Metadata (Multi-Tenant Scoping)
ADMIN_STAFF_ID=EXAM_ADMIN_MGM
ADMIN_FULL_NAME=Prof. V. M. Deshpande
ADMIN_DEPARTMENT=Examination Authority
ADMIN_AUTHORIZED_WALLET=0x8D0cC3553e9d812797B986F15427835A2930a301
ADMIN_INSTITUTION_CODE=MGMU-ENG-01
ADMIN_INSTITUTION_NAME=MGM University, Chhatrapati Sambhajinagar

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN & SMART CONTRACT REGISTRY (ETHEREUM SEPOLIA)
# ------------------------------------------------------------------------------
# Chain ID for Ethereum Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=11155111

# High-availability Sepolia JSON-RPC Provider.
# For production SLA, use a dedicated RPC endpoint (Alchemy, Infura, QuickNode)
# with a fallback public node to ensure zero verification downtime.
NEXT_PUBLIC_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Secondary fallback RPC: https://ethereum-sepolia-rpc.publicnode.com

# Deployed CredentialRegistry contract address on Sepolia
NEXT_PUBLIC_CREDENTIAL_REGISTRY=0xe7Cc39AF2ACC1dd637C863aB5DB18aC904b76Bc4

# Deployed StudentIdentityRegistry contract address on Sepolia
NEXT_PUBLIC_IDENTITY_REGISTRY=0xa8e6B6bAEa48F78eBFeE5967B9836779691c0971

# Optional: Private key for backend contract transactions (ONLY for offline anchor worker;
# verification and public inspection are strictly gasless eth_call queries).
# PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# ARCHITECTURE A: Serverless Deployments (Vercel, AWS Lambda)
# On serverless platforms with ephemeral filesystems, Turso / remote libSQL is strictly required.
# Local SQLite is blocked in production unless ALLOW_LOCAL_SQLITE=true.
TURSO_DATABASE_URL=libsql://veritrust-prod-YOUR_DB_SLUG.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_JWT_AUTH_TOKEN

# Remote database timeouts (milliseconds)
TURSO_QUERY_TIMEOUT_MS=5000
TURSO_TRANSACTION_TIMEOUT_MS=15000

# ARCHITECTURE B: Container Deployments (Docker, Kubernetes, Render, Railway)
# If running inside a container with a persistent volume mounted to /app/data:
# Uncomment below and set ALLOW_LOCAL_SQLITE=true.
# DATABASE_PATH=/app/data/veritrust.db
# ALLOW_LOCAL_SQLITE=true

# Database Seeding Policy
# CRITICAL: Keep 'false' in production. Setting to 'true' would re-seed demo data
# and could overwrite or mask genuine academic records if persistent storage was unmounted.
ALLOW_AUTO_SEED=false

# ------------------------------------------------------------------------------
# 5. IPFS DECENTRALIZED STORAGE (PINATA)
# ------------------------------------------------------------------------------
# Used by the Examination Authority to pin encrypted graduation batch manifests.
# Provide either PINATA_JWT or the API_KEY + SECRET pair.
PINATA_JWT=YOUR_PINATA_PRODUCTION_JWT_TOKEN
# PINATA_API_KEY=
# PINATA_SECRET_API_KEY=

# ------------------------------------------------------------------------------
# 6. PYTHON AI FORENSIC MICROSERVICE (FASTAPI)
# ------------------------------------------------------------------------------
# Internal or public URL of the Python FastAPI Error Level Analysis (ELA) microservice.
# In Docker Compose / Kubernetes, use internal DNS (e.g. http://forgery-service:8000).
# On cloud platforms (Render, Railway), use the private service mesh URL.
# On Hugging Face Spaces (Community Docker): https://<your-username>-soet-veritrust-ai.hf.space
AI_FORENSIC_SERVICE_URL=http://forgery-service:8000
# AI_FORENSIC_SERVICE_URL=https://<your-username>-soet-veritrust-ai.hf.space
# AI_FORENSIC_SERVICE_URL=http://127.0.0.1:8000

# Shared secret token securing the AI forensic microservice from unauthorized public access.
# When set, Next.js passes this token in the X-Forensic-Secret header.
AI_FORENSIC_SECRET=REPLACE_WITH_STRONG_SHARED_MICROSERVICE_SECRET

# Timeout (milliseconds) for AI forensic scan before falling back to cryptographic proof alone.
AI_FORENSIC_TIMEOUT_MS=12000

# Microservice internal concurrency admission limits:
AI_MAX_QUEUE_SIZE=2
AI_QUEUE_TIMEOUT_SECONDS=8.0
AI_INFERENCE_TIMEOUT_SECONDS=25.0

# Optional path to a fine-tuned PyTorch CNN checkpoint (.pt or .pth file).
# If omitted or unpopulated, the forensic microservice explicitly operates in
# HEURISTIC_BASELINE_UNTRAINED mode using localized spatial residual calculations.
# AI_MODEL_CHECKPOINT_PATH=/app/checkpoints/best_ela_model.pth

