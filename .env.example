# Environment Configuration for Ethereum Sepolia & SOET VeriTrust
# DO NOT commit real private keys to version control!

# Public Contract Addresses on Sepolia
NEXT_PUBLIC_CREDENTIAL_REGISTRY=0xe7Cc39AF2ACC1dd637C863aB5DB18aC904b76Bc4
NEXT_PUBLIC_IDENTITY_REGISTRY=0xa8e6B6bAEa48F78eBFeE5967B9836779691c0971

# Ethereum Sepolia JSON-RPC Provider
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=11155111

# REQUIRED SERVER-SIDE AUTHENTICATION CREDENTIALS
# WARNING: These MUST be set on the deployment platform (e.g., Vercel Environment Variables)
# as well as in your local .env. The server will throw a clear error and refuse to
# authenticate if any of these variables are missing. NEVER commit real values to GitHub!
AUTH_SECRET=
ADMIN_PASSWORD=
STUDENT_DEFAULT_PASSWORD=

# Smart Contract Deployment (Only used in deployment scripts)
# PRIVATE_KEY=your_private_key_here

# REQUIRED SERVER-SIDE PINATA IPFS STORAGE CREDENTIALS
# WARNING: Required for pinning degree batch payloads to IPFS.
# Provide either PINATA_JWT or the PINATA_API_KEY + PINATA_SECRET_API_KEY pair.
# The server will refuse batch uploads if missing. NEVER commit real values!
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# PERSISTENT SQLITE DATABASE CONFIGURATION
# Path to the SQLite database file on the local filesystem or container volume.
# For local development: ./data/veritrust.db
# For Docker container deployment: /app/data/veritrust.db (mounted to persistent host volume)
DATABASE_PATH=./data/veritrust.db

# TURSO / libSQL PRODUCTION DATABASE CONFIGURATION
# For production serverless deployments (e.g. Vercel), set persistent remote Turso credentials.
# In production (NODE_ENV=production), these are strictly required; fallback to local SQLite is prohibited.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# TURSO / libSQL RESILIENCE & BOUNDED TIMEOUTS
# Optional timeout configurations for remote Turso/libSQL database operations.
# TURSO_QUERY_TIMEOUT_MS: Maximum time in ms for single read/query operations (default: 5000)
# TURSO_TRANSACTION_TIMEOUT_MS: Maximum time in ms for atomic batch and transaction operations (default: 15000)
# TURSO_QUERY_TIMEOUT_MS=5000
# TURSO_TRANSACTION_TIMEOUT_MS=15000

# SAFE PRODUCTION DATABASE INITIALIZATION
# Set to 'true' ONLY during the very first deployment of a fresh environment if you want the system
# to automatically seed initial demo graduation batches.
# In production (NODE_ENV=production), defaults to 'false' to prevent silently overwriting or masking
# missing institutional records if the persistent storage volume failed to mount.
ALLOW_AUTO_SEED=false

# AI FORENSIC MICROSERVICE CONFIGURATION
# URL of the Python FastAPI Error Level Analysis (ELA) and CNN microservice.
# For local host development: http://127.0.0.1:8000
# For Docker Compose internal network: http://forgery-service:8000
AI_FORENSIC_SERVICE_URL=http://127.0.0.1:8000

# FASTAPI AI FORENSIC CORS CONFIGURATION
# Comma-separated list of allowed origins for the Python FastAPI microservice.
# Defaults to http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001 if omitted.
# In Docker Compose: http://localhost:3000,http://web:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PUBLIC APPLICATION ORIGIN
# Canonical public URL used for generating official QR verification links on PDF certificates.
# In production, set to your canonical domain (e.g., https://soet-veritrust.vercel.app).
# Prevents Host-header poisoning and unauthorized QR redirection.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REVERSE PROXY TRUST CONFIGURATION
# Set to 'true' ONLY if running behind a trusted reverse proxy (e.g., Nginx, Cloudflare, AWS ALB)
# that strips and replaces client-supplied X-Forwarded-For / CF-Connecting-IP headers.
# Defaults to false, which safely ignores client-supplied forwarding headers to prevent rate-limit bypass.
TRUST_PROXY=false
